<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>IRSHO MOVIES</title>

<style>
*{box-sizing:border-box}
body{margin:0;background:#080808;color:white;font-family:Arial,sans-serif}
header{padding:18px;background:#111;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:5}
.logo{color:#e50914;font-size:25px;font-weight:bold}
button{background:#e50914;color:white;border:0;padding:11px 15px;border-radius:6px;font-weight:bold}
input,select{padding:12px;border:0;border-radius:6px;margin:6px;background:#222;color:white}
.hero{padding:35px 20px;background:linear-gradient(90deg,#000,#222);min-height:210px}
.hero h1{font-size:34px}
section{padding:15px}
.cards{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.card{background:#171717;border-radius:9px;overflow:hidden}
.card img{width:100%;height:190px;object-fit:cover;background:#333}
.card h3{padding:0 10px}
.card button{margin:5px}
#playerBox{display:none;position:fixed;inset:0;background:black;z-index:20}
#player{width:100%;height:100%;background:black;object-fit:contain}
#closePlayer{position:absolute;top:15px;right:15px;z-index:22}
#uploadBox{padding:15px;background:#151515;margin:15px;border-radius:10px}
</style>
</head>

<body>

<header>
<div class="logo">IRSHO MOVIES</div>
<button onclick="document.getElementById('uploadBox').scrollIntoView()">＋ Upload</button>
</header>

<div class="hero">
<h1>Unlimited Movies</h1>
<p>Watch your favourite movies on IRSHO MOVIES</p>
</div>

<section>
<input id="search" placeholder="Search movies..." oninput="render()">
<select id="category" onchange="render()">
<option value="All">All Categories</option>
<option>Action</option>
<option>Comedy</option>
<option>Horror</option>
<option>Anime</option>
<option>Drama</option>
</select>
</section>

<section>
<h2>🔥 Trending Movies</h2>
<div class="cards" id="movieList"></div>
</section>

<div id="uploadBox">
<h2>＋ Add Movie</h2>
<input id="movieName" placeholder="Movie Name">
<select id="movieCategory">
<option>Action</option>
<option>Comedy</option>
<option>Horror</option>
<option>Anime</option>
<option>Drama</option>
</select>
<p>Movie Poster</p>
<input type="file" id="poster" accept="image/*">
<p>Movie Video</p>
<input type="file" id="video" accept="video/*">
<button onclick="addMovie()">Add Movie</button>
</div>

<div id="playerBox">
<button id="closePlayer" onclick="closePlayer()">✕ Close</button>
<video id="player" controls playsinline></video>
</div>

<script>
let db;

const request = indexedDB.open("IrshoMoviesDB",1);

request.onupgradeneeded = function(e){
 db=e.target.result;
 if(!db.objectStoreNames.contains("movies")){
  db.createObjectStore("movies",{keyPath:"id",autoIncrement:true});
 }
};

request.onsuccess = function(e){
 db=e.target.result;
 render();
};

request.onerror = function(){
 alert("Storage open nahi hua");
};

function addMovie(){
 const name=document.getElementById("movieName").value.trim();
 const poster=document.getElementById("poster").files[0];
 const video=document.getElementById("video").files[0];
 const category=document.getElementById("movieCategory").value;

 if(!name || !poster || !video){
  alert("Movie name, poster aur video select karo");
  return;
 }

 const tx=db.transaction("movies","readwrite");
 tx.objectStore("movies").add({
  name,category,poster,video
 });

 tx.oncomplete=()=>{
  alert("Movie added!");
  document.getElementById("movieName").value="";
  document.getElementById("poster").value="";
  document.getElementById("video").value="";
  render();
 };
}

function render(){
 if(!db)return;

 const list=document.getElementById("movieList");
 list.innerHTML="";

 const search=document.getElementById("search").value.toLowerCase();
 const category=document.getElementById("category").value;

 const tx=db.transaction("movies","readonly");
 const req=tx.objectStore("movies").getAll();

 req.onsuccess=()=>{
  req.result.forEach(movie=>{
   if(!movie.name.toLowerCase().includes(search))return;
   if(category!=="All" && (movie.category||"Other")!==category)return;

   const card=document.createElement("div");
   card.className="card";

   const img=document.createElement("img");
   const posterUrl=URL.createObjectURL(movie.poster);
   img.src=posterUrl;

   const title=document.createElement("h3");
   title.textContent=movie.name;

   const watch=document.createElement("button");
   watch.textContent="▶ Watch";
   watch.onclick=()=>playMovie(movie.video);

   const del=document.createElement("button");
   del.textContent="Delete";
   del.onclick=()=>deleteMovie(movie.id);

   card.append(img,title,watch,del);
   list.appendChild(card);
  });
 };
}

function playMovie(file){
 const player=document.getElementById("player");
 document.getElementById("playerBox").style.display="block";

 if(player.src)URL.revokeObjectURL(player.src);
 player.src=URL.createObjectURL(file);
 player.load();
 player.play();

 if(player.requestFullscreen){
  player.requestFullscreen().catch(()=>{});
 }else if(player.webkitEnterFullscreen){
  player.webkitEnterFullscreen();
 }
}

function closePlayer(){
 const player=document.getElementById("player");
 player.pause();
 player.removeAttribute("src");
 player.load();

 if(document.fullscreenElement){
  document.exitFullscreen().catch(()=>{});
 }
 document.getElementById("playerBox").style.display="none";
}

function deleteMovie(id){
 if(!confirm("Delete this movie?"))return;
 const tx=db.transaction("movies","readwrite");
 tx.objectStore("movies").delete(id);
 tx.oncomplete=render;
}
</script>

</body>
  </html>
